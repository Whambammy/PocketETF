# Self-custody swaps do not need an operator enablement flag, server signing
# secret, Redis subscription, or external eligibility service.
# Never configure a user private key or seed phrase.

# Set the canonical Vercel/custom HTTPS domain when deploying.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: dedicated mainnet RPC. Public fallbacks are built in.
# Keep provider credentials server-side; do not use a NEXT_PUBLIC_ RPC secret.
SOLANA_RPC_URL=

# Optional: higher Jupiter quotas. Keyless routing is supported and paced.
JUPITER_API_KEY=

# Optional: shared request counters across Vercel instances.
# Per-instance limits work without Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
