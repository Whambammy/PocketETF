# ====================================================================
# PocketETF Protocol - Environment Configuration Template
# Copy to .env.local for local development: cp .env.example .env.local
# ====================================================================

# Solana Mainnet-Beta RPC Endpoint
# Recommended: Helius, QuickNode, or Alchemy dedicated endpoint to avoid public rate limits
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Base Application URL (Required for Solana Actions absolute icon & callback URLs)
# In development: http://localhost:3000
# In production: https://pocketetf.app or your Vercel deployment URL
NEXT_PUBLIC_BASE_URL=https://pocketetf.vercel.app

# Canonical Solana USDC Mint Address (6 decimals)
# Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Jupiter Aggregator v6 / Swap API Base URL
# Default: lite-api.jup.ag provides high throughput without strict IP-based rate limiting
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1

# Optional: Jupiter API Key for higher dedicated rate limits on api.jup.ag
# JUPITER_API_KEY=your_jupiter_api_key_here

# Optional Token Mint Overrides (Defaults configured in constants.ts)
# MINT_NVDA=7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU
# MINT_TSM=3NZ9JMVBmGAqocybic2c7LQCJScmgsAZ6vQqTDzcqmJh
# MINT_AMD=2FPyTwcZLUg1MDrwsyoP4D6s1tM7hAkHYRjkNb5w6Pxk
# MINT_AAPL=4k3Dyjzvzp8eMZWUXbBCjEvwSkkk59S5iCNLY3QrkX6R
# MINT_SPY=JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN
